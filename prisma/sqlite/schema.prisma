generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int      @id @default(autoincrement())
  email                 String   @unique
  password              String
  name                  String
  photo                 String?
  calendarFeedToken     String?  @unique
  calendarFeedEnabled   Boolean  @default(false)
  calendarFeedPreferences String?
  role                  String   @default("admin")
  accessProfileId       Int?
  accessProfile         AccessProfile? @relation(fields: [accessProfileId], references: [id], onDelete: SetNull)
  permissionOverrides   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  notificationDismissals NotificationDismissal[]
  permissionAuditChanges PermissionAuditLog[] @relation("PermissionAuditActor")
  permissionAuditTargets PermissionAuditLog[] @relation("PermissionAuditTarget")

  @@index([accessProfileId])
}

model AccessProfile {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  description String?
  permissions String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  auditLogs   PermissionAuditLog[]

  @@index([isSystem])
}

model PermissionAuditLog {
  id              Int      @id @default(autoincrement())
  actorId         Int?
  actor           User?    @relation("PermissionAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId    Int?
  targetUser      User?    @relation("PermissionAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  accessProfileId Int?
  accessProfile   AccessProfile? @relation(fields: [accessProfileId], references: [id], onDelete: SetNull)
  action          String
  changes         String
  createdAt       DateTime @default(now())

  @@index([actorId])
  @@index([targetUserId])
  @@index([accessProfileId])
}

model NotificationDismissal {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

model ImportMapping {
  id            Int      @id @default(autoincrement())
  source        String
  scopeKey      String   @default("global")
  field         String
  externalValue String
  internalValue String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([source, scopeKey, field, externalValue])
  @@index([source, field])
}

model Collaborator {
  id          Int               @id @default(autoincrement())
  name        String
  email       String            @unique
  phone       String?
  nif         String?
  iban        String?
  shortName      String?
  birthDate      DateTime?
  gender         String?
  documentType   String?
  documentNumber String?
  documentExpiry DateTime?
  documentExtended Boolean     @default(false)
  residenceArea  String?
  insurancePolicy String?
  allergies      String?
  greenReceipt   String?
  availability   String?
  photo          String?
  photoThumb     String?
  address     String?
  category    String            @default("")
  hourlyRate  Decimal           @default(0)
  includeVat  Boolean           @default(false)
  hasOwnCar   Boolean           @default(false)
  isPreferred Boolean           @default(false)
  status      String            @default("active")
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  assignments EventAssignment[]
  payments    Payment[]
  roles       CollaboratorRole[]
  communicationLogs CommunicationLog[]
  qrCheckCodes QrCheckCode[]
  qrCheckLogs  QrCheckLog[]

  @@index([status])
  @@index([category])
}

model CollaboratorRole {
  id             Int          @id @default(autoincrement())
  collaboratorId Int
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime     @default(now())

  @@unique([collaboratorId, role])
  @@index([role])
}

model Client {
  id            Int       @id @default(autoincrement())
  name          String
  email         String?
  phone         String?
  nif           String?
  address       String?
  postalCode    String?
  city          String?
  contactPerson String?
  representativeName String?
  type          String    @default("company")
  billingMethod String    @default("per_event")
  billingCustomRule String?
  paymentTerm   String    @default("days_30")
  paymentTermDays Int?
  minimumHours  Decimal   @default(0)
  roleRates     String?
  roleRatesUpdatedAt DateTime?
  defaultUniform String?
  defaultOnsiteContactName String?
  defaultOnsiteContactPhone String?
  prepaymentPercent Decimal @default(70)
  prepaymentRemainingDaysBefore Int @default(7)
  status        String    @default("active")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  events        Event[]
  invoices      Invoice[]
  budgets       Budget[]

  @@index([status])
  @@index([type])
}

model Budget {
  id            Int      @id @default(autoincrement())
  reference     String   @unique
  clientId      Int?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  eventDate     DateTime?
  leadName      String?
  companyName   String?
  phone         String?
  email         String?
  nif           String?
  eventType     String?
  guestsCount   Int?
  startTime     String?
  endTime       String?
  leadSource    String?
  serviceType   String?
  eventLevel    String?
  regularClient Boolean?
  locationScope String?
  minimumHours  Decimal  @default(0)
  sentAt        DateTime?
  lostReason    String?
  followUpHistory String?
  responseTemplate String?
  commercialEmailText String?
  commercialWhatsappText String?
  commercialPdfText String?
  marginAmount  Decimal  @default(0)
  budgetType    String   @default("company")
  location      String?
  description   String?
  amount        Decimal  @default(0)
  vatRate       Decimal  @default(23)
  travelType    String   @default("none")
  travelPeople  Int?
  km            Decimal?
  kmRate        Decimal?
  durationHours Decimal?
  split5050     Boolean  @default(false)
  baseAmount    Decimal  @default(0)
  travelAmount  Decimal  @default(0)
  travelCars    String?
  taxAmount     Decimal  @default(0)
  totalWithTax  Decimal  @default(0)
  discountRate  Decimal  @default(0)
  discountAmount Decimal @default(0)
  totalAmount   Decimal  @default(0)
  categories    String?
  externalCosts String?
  paymentPlan   String?
  status        String   @default("new_request")
  paymentStatus String   @default("pending")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([paymentStatus])
  @@index([eventDate])
  @@index([sentAt])
  @@index([leadSource])
}

model Event {
  id           Int               @id @default(autoincrement())
  name         String
  serviceReference String?
  eventType    String?
  description  String?
  clientId     Int?
  client       Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName   String?
  location     String?
  useDefaultLocation Boolean      @default(true)
  date         DateTime
  endDate      DateTime?
  isContinuous Boolean            @default(false)
  workLocationsEnabled Boolean    @default(false)
  startTime    String?
  endTime      String?
  actualStartTime String?
  actualEndTime   String?
  realHours       Decimal         @default(0)
  billableHours   Decimal         @default(0)
  minimumHoursSnapshot Decimal    @default(0)
  guestsCount  Int?
  requiredRoles String?
  rateHistory  String?
  externalCosts String?
  uniform      String?
  meetingPoint String?
  onsiteContactName String?
  onsiteContactPhone String?
  travelExpenseEnabled Boolean    @default(false)
  travelExpenseAmount Decimal     @default(0)
  travelType   String             @default("none")
  travelPeople Int?
  km           Decimal?
  kmRate       Decimal?
  durationHours Decimal?
  travelStaffHourlyRate Decimal @default(0)
  split5050    Boolean            @default(false)
  travelManualAmount Decimal      @default(0)
  travelCars   String?
  assignmentDrafts String?
  cancelledDays String?
  billingStatus String            @default("pending")
  billingPaymentDate DateTime?
  signaledAt    DateTime?
  signaledAmount Decimal          @default(0)
  paidAmount Decimal              @default(0)
  remainingPaymentDate DateTime?
  status       String            @default("pending")
  statusMode   String            @default("automatic")
  totalCost    Decimal           @default(0)
  totalRevenue Decimal           @default(0)
  billingAdjustment Decimal      @default(0)
  vatRateSnapshot Decimal        @default(0)
  taxAmount    Decimal           @default(0)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assignments  EventAssignment[]
  workLocations EventWorkLocation[]
  invoices     Invoice[]
  communicationLogs CommunicationLog[]
  qrCheckCodes QrCheckCode[]
  qrCheckLogs  QrCheckLog[]

  @@index([clientId])
  @@index([date])
  @@index([status])
}

model EventTemplate {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  eventType   String?
  description String?
  payload     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventType])
}

model EventWorkLocation {
  id          Int               @id @default(autoincrement())
  eventId     Int
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  assignments EventAssignment[]

  @@unique([eventId, name])
  @@index([eventId, sortOrder])
}

model EventAssignment {
  id             Int          @id @default(autoincrement())
  eventId        Int
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  collaboratorId Int
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id])
  workLocationId Int?
  workLocation   EventWorkLocation? @relation(fields: [workLocationId], references: [id], onDelete: SetNull)
  assignmentDate DateTime?
  role           String?
  plannedCheckIn String?
  plannedCheckOut String?
  checkIn        String?
  checkOut       String?
  clientCheckIn  String?
  clientCheckOut String?
  validatedCheckIn String?
  validatedCheckOut String?
  hoursWorked    Decimal      @default(0)
  clientRealHours Decimal     @default(0)
  clientBillableHours Decimal @default(0)
  staffPayableHours Decimal   @default(0)
  hourlyRate     Decimal      @default(0)
  totalPay       Decimal      @default(0)
  validationStatus String     @default("pending")
  validationNotes  String?
  clientSynced     Boolean    @default(false)
  whatsappEnabled  Boolean    @default(true)
  isDriver         Boolean    @default(false)
  status         String       @default("assigned")
  paymentStatus  String       @default("unpaid")
  paymentDate    DateTime?
  paymentDeferredMonth String?
  paymentAdjustment Decimal   @default(0)
  paymentNotes   String?
  advancePayments String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  communicationLogs CommunicationLog[]
  qrCheckCode   QrCheckCode?
  qrCheckLogs   QrCheckLog[]

  @@index([eventId, collaboratorId, role])
  @@index([collaboratorId])
  @@index([workLocationId])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentDeferredMonth])
}

model QrCheckCode {
  id             Int              @id @default(autoincrement())
  token          String           @unique
  eventId        Int
  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignmentId   Int              @unique
  assignment     EventAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  collaboratorId Int
  collaborator   Collaborator     @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  eventDate      DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  logs           QrCheckLog[]

  @@index([eventId])
  @@index([assignmentId])
  @@index([collaboratorId])
  @@index([eventDate])
  @@index([expiresAt])
}

model QrCheckLog {
  id             Int              @id @default(autoincrement())
  qrCodeId       Int
  qrCode         QrCheckCode      @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  eventId        Int
  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignmentId   Int
  assignment     EventAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  collaboratorId Int
  collaborator   Collaborator     @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  action         String
  recordedAt     DateTime         @default(now())
  ip             String?
  userAgent      String?
  createdAt      DateTime         @default(now())

  @@index([qrCodeId])
  @@index([eventId])
  @@index([assignmentId])
  @@index([collaboratorId])
  @@index([action])
  @@index([recordedAt])
}

model CommunicationLog {
  id             Int              @id @default(autoincrement())
  eventId        Int
  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignmentId   Int
  assignment     EventAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  collaboratorId Int
  collaborator   Collaborator     @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  type           String           @default("confirmation")
  channel        String           @default("manual_whatsapp")
  status         String           @default("prepared")
  message        String?
  response       String?
  dedupeKey      String?           @unique
  sentAt         DateTime?
  respondedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([eventId])
  @@index([assignmentId])
  @@index([collaboratorId])
  @@index([status])
  @@index([type])
}

model Invoice {
  id        Int           @id @default(autoincrement())
  number    String        @unique
  clientId  Int
  client    Client        @relation(fields: [clientId], references: [id])
  eventId   Int?
  eventIds  String?
  billingPeriodLabel String?
  event     Event?        @relation(fields: [eventId], references: [id])
  issueDate DateTime      @default(now())
  dueDate   DateTime?
  subtotal  Decimal       @default(0)
  taxRate   Decimal       @default(23)
  taxAmount Decimal       @default(0)
  total     Decimal       @default(0)
  status    String        @default("draft")
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  items     InvoiceItem[]

  @@index([clientId])
  @@index([eventId])
  @@index([status])
  @@index([issueDate])
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @default(1)
  unitPrice   Decimal @default(0)
  total       Decimal @default(0)

  @@index([invoiceId])
}

model Payment {
  id             Int          @id @default(autoincrement())
  collaboratorId Int
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id])
  amount         Decimal
  description    String?
  date           DateTime     @default(now())
  status         String       @default("pending")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([collaboratorId])
  @@index([date])
  @@index([status])
}

model Transaction {
  id          Int      @id @default(autoincrement())
  type        String
  category    String
  amount      Decimal
  vatAmount   Decimal  @default(0)
  supplier    String?
  description String?
  documentName String?
  documentData String?
  sentToAccountant Boolean @default(false)
  date        DateTime @default(now())
  referenceId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([date])
}
