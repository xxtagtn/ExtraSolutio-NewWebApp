generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(191)
  password  String   @db.VarChar(191)
  name      String   @db.VarChar(191)
  role      String   @default("admin") @db.VarChar(40)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  notificationDismissals NotificationDismissal[]
}

model NotificationDismissal {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String   @db.VarChar(191)
  createdAt DateTime @default(now()) @db.DateTime(3)

  @@unique([userId, key], map: "NotificationDismissal_userId_key_key")
  @@index([userId], map: "NotificationDismissal_userId_idx")
}

model Collaborator {
  id          Int               @id @default(autoincrement())
  name        String            @db.VarChar(191)
  email       String            @unique @db.VarChar(191)
  phone       String?           @db.VarChar(40)
  nif         String?           @db.VarChar(30)
  iban        String?           @db.VarChar(60)
  shortName      String?        @db.VarChar(120)
  birthDate      DateTime?      @db.DateTime(3)
  gender         String?        @db.VarChar(30)
  documentType   String?        @db.VarChar(40)
  documentNumber String?        @db.VarChar(80)
  documentExpiry DateTime?      @db.DateTime(3)
  documentExtended Boolean      @default(false)
  residenceArea  String?        @db.VarChar(120)
  insurancePolicy String?       @db.VarChar(120)
  allergies      String?        @db.Text
  greenReceipt   String?        @db.VarChar(20)
  availability   String?        @db.Text
  photo          String?        @db.LongText
  address     String?           @db.Text
  category    String            @default("") @db.VarChar(80)
  hourlyRate  Decimal           @default(0) @db.Decimal(12, 2)
  includeVat  Boolean           @default(false)
  isPreferred Boolean           @default(false)
  status      String            @default("active") @db.VarChar(40)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now()) @db.DateTime(3)
  updatedAt   DateTime          @updatedAt @db.DateTime(3)
  assignments EventAssignment[]
  payments    Payment[]
  roles       CollaboratorRole[]

  @@index([status])
  @@index([category])
}

model CollaboratorRole {
  id             Int          @id @default(autoincrement())
  collaboratorId Int
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  role           String       @db.VarChar(80)
  createdAt      DateTime     @default(now()) @db.DateTime(3)

  @@unique([collaboratorId, role])
  @@index([role])
}

model Client {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(191)
  email         String?   @db.VarChar(191)
  phone         String?   @db.VarChar(40)
  nif           String?   @db.VarChar(30)
  address       String?   @db.Text
  postalCode    String?   @db.VarChar(20)
  city          String?   @db.VarChar(100)
  contactPerson String?   @db.VarChar(191)
  representativeName String? @db.VarChar(191)
  type          String    @default("company") @db.VarChar(40)
  billingMethod String    @default("per_event") @db.VarChar(40)
  billingCustomRule String? @db.Text
  paymentTerm   String    @default("days_30") @db.VarChar(40)
  paymentTermDays Int?
  roleRates     String?   @db.LongText
  roleRatesUpdatedAt DateTime? @db.DateTime(3)
  status        String    @default("active") @db.VarChar(40)
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @db.DateTime(3)
  events        Event[]
  invoices      Invoice[]
  budgets       Budget[]

  @@index([status])
  @@index([type])
}

model Budget {
  id            Int      @id @default(autoincrement())
  reference     String   @unique @db.VarChar(60)
  clientId      Int?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  eventDate     DateTime? @db.DateTime(3)
  leadName      String?  @db.VarChar(191)
  companyName   String?  @db.VarChar(191)
  phone         String?  @db.VarChar(40)
  email         String?  @db.VarChar(191)
  nif           String?  @db.VarChar(30)
  eventType     String?  @db.VarChar(80)
  guestsCount   Int?
  startTime     String?  @db.VarChar(20)
  endTime       String?  @db.VarChar(20)
  leadSource    String?  @db.VarChar(80)
  serviceType   String?  @db.VarChar(80)
  eventLevel    String?  @db.VarChar(40)
  regularClient Boolean?
  locationScope String?  @db.VarChar(40)
  minimumHours  Decimal  @default(0) @db.Decimal(8, 2)
  sentAt        DateTime? @db.DateTime(3)
  lostReason    String?  @db.VarChar(120)
  followUpHistory String? @db.LongText
  responseTemplate String? @db.VarChar(80)
  commercialEmailText String? @db.LongText
  commercialWhatsappText String? @db.LongText
  commercialPdfText String? @db.LongText
  budgetType    String   @default("company") @db.VarChar(40)
  location      String?  @db.Text
  description   String?  @db.Text
  amount        Decimal  @default(0) @db.Decimal(12, 2)
  vatRate       Decimal  @default(23) @db.Decimal(5, 2)
  travelType    String   @default("none") @db.VarChar(40)
  travelPeople  Int?
  km            Decimal? @db.Decimal(10, 2)
  kmRate        Decimal? @db.Decimal(8, 2)
  durationHours Decimal? @db.Decimal(8, 2)
  split5050     Boolean  @default(false)
  baseAmount    Decimal  @default(0) @db.Decimal(12, 2)
  travelAmount  Decimal  @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal  @default(0) @db.Decimal(12, 2)
  totalWithTax  Decimal  @default(0) @db.Decimal(12, 2)
  discountRate  Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal  @default(0) @db.Decimal(12, 2)
  marginAmount  Decimal  @default(0) @db.Decimal(12, 2)
  categories    String?  @db.LongText
  paymentPlan   String?  @db.LongText
  status        String   @default("new_request") @db.VarChar(40)
  paymentStatus String   @default("pending") @db.VarChar(40)
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt     DateTime @updatedAt @db.DateTime(3)

  @@index([clientId])
  @@index([status])
  @@index([paymentStatus])
  @@index([eventDate])
  @@index([sentAt])
  @@index([leadSource])
}

model Event {
  id           Int               @id @default(autoincrement())
  name         String            @db.VarChar(191)
  eventType    String?           @db.VarChar(80)
  description  String?           @db.Text
  clientId     Int
  client       Client            @relation(fields: [clientId], references: [id])
  location     String?           @db.Text
  useDefaultLocation Boolean      @default(true)
  date         DateTime          @db.DateTime(3)
  endDate      DateTime?         @db.DateTime(3)
  isContinuous Boolean           @default(false)
  startTime    String?           @db.VarChar(20)
  endTime      String?           @db.VarChar(20)
  actualStartTime String?        @db.VarChar(20)
  actualEndTime   String?        @db.VarChar(20)
  billableHours   Decimal        @default(0) @db.Decimal(8, 2)
  guestsCount  Int?
  requiredRoles String?          @db.LongText
  uniform      String?           @db.VarChar(80)
  meetingPoint String?           @db.Text
  onsiteContactName String?      @db.VarChar(191)
  onsiteContactPhone String?     @db.VarChar(40)
  travelExpenseEnabled Boolean    @default(false)
  travelExpenseAmount Decimal     @default(0) @db.Decimal(12, 2)
  travelType   String             @default("none") @db.VarChar(40)
  travelPeople Int?
  km           Decimal?          @db.Decimal(10, 2)
  kmRate       Decimal?          @db.Decimal(8, 2)
  durationHours Decimal?         @db.Decimal(8, 2)
  split5050    Boolean           @default(false)
  travelManualAmount Decimal     @default(0) @db.Decimal(12, 2)
  billingStatus String           @default("pending") @db.VarChar(40)
  billingPaymentDate DateTime?   @db.DateTime(3)
  signaledAmount Decimal         @default(0) @db.Decimal(12, 2)
  paidAmount Decimal             @default(0) @db.Decimal(12, 2)
  remainingPaymentDate DateTime? @db.DateTime(3)
  status       String            @default("pending") @db.VarChar(40)
  totalCost    Decimal           @default(0) @db.Decimal(12, 2)
  totalRevenue Decimal           @default(0) @db.Decimal(12, 2)
  notes        String?           @db.Text
  createdAt    DateTime          @default(now()) @db.DateTime(3)
  updatedAt    DateTime          @updatedAt @db.DateTime(3)
  assignments  EventAssignment[]
  invoices     Invoice[]

  @@index([clientId])
  @@index([date])
  @@index([status])
}

model EventTemplate {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(191)
  eventType   String?  @db.VarChar(80)
  description String?  @db.Text
  payload     String   @db.LongText
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  @@index([eventType])
}

model EventAssignment {
  id             Int          @id @default(autoincrement())
  eventId        Int
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  collaboratorId Int
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id])
  assignmentDate DateTime?    @db.DateTime(3)
  role           String?      @db.VarChar(80)
  checkIn        String?      @db.VarChar(20)
  checkOut       String?      @db.VarChar(20)
  clientCheckIn  String?      @db.VarChar(20)
  clientCheckOut String?      @db.VarChar(20)
  validatedCheckIn String?    @db.VarChar(20)
  validatedCheckOut String?   @db.VarChar(20)
  hoursWorked    Decimal      @default(0) @db.Decimal(8, 2)
  clientBillableHours Decimal @default(0) @db.Decimal(8, 2)
  staffPayableHours Decimal   @default(0) @db.Decimal(8, 2)
  hourlyRate     Decimal      @default(0) @db.Decimal(12, 2)
  totalPay       Decimal      @default(0) @db.Decimal(12, 2)
  validationStatus String     @default("pending") @db.VarChar(40)
  validationNotes  String?    @db.Text
  status         String       @default("assigned") @db.VarChar(40)
  paymentStatus  String       @default("unpaid") @db.VarChar(40)
  paymentDate    DateTime?    @db.DateTime(3)
  paymentAdjustment Decimal   @default(0) @db.Decimal(12, 2)
  paymentNotes   String?      @db.LongText
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)

  @@index([eventId, collaboratorId, role], map: "EventAssignment_eventId_collaboratorId_role_idx")
  @@index([collaboratorId])
  @@index([status])
  @@index([paymentStatus])
}

model Invoice {
  id        Int           @id @default(autoincrement())
  number    String        @unique @db.VarChar(60)
  clientId  Int
  client    Client        @relation(fields: [clientId], references: [id])
  eventId   Int?
  eventIds  String?       @db.LongText
  billingPeriodLabel String? @db.VarChar(191)
  event     Event?        @relation(fields: [eventId], references: [id])
  issueDate DateTime      @default(now()) @db.DateTime(3)
  dueDate   DateTime?     @db.DateTime(3)
  subtotal  Decimal       @default(0) @db.Decimal(12, 2)
  taxRate   Decimal       @default(23) @db.Decimal(5, 2)
  taxAmount Decimal       @default(0) @db.Decimal(12, 2)
  total     Decimal       @default(0) @db.Decimal(12, 2)
  status    String        @default("draft") @db.VarChar(40)
  notes     String?       @db.Text
  createdAt DateTime      @default(now()) @db.DateTime(3)
  updatedAt DateTime      @updatedAt @db.DateTime(3)
  items     InvoiceItem[]

  @@index([clientId])
  @@index([eventId])
  @@index([status])
  @@index([issueDate])
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String  @db.Text
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @default(0) @db.Decimal(12, 2)

  @@index([invoiceId])
}

model Payment {
  id             Int          @id @default(autoincrement())
  collaboratorId Int
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id])
  amount         Decimal      @db.Decimal(12, 2)
  description    String?      @db.Text
  date           DateTime     @default(now()) @db.DateTime(3)
  status         String       @default("pending") @db.VarChar(40)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)

  @@index([collaboratorId])
  @@index([date])
  @@index([status])
}

model Transaction {
  id          Int      @id @default(autoincrement())
  type        String   @db.VarChar(40)
  category    String   @db.VarChar(80)
  amount      Decimal  @db.Decimal(12, 2)
  vatAmount   Decimal  @default(0) @db.Decimal(12, 2)
  supplier    String?  @db.VarChar(191)
  description String?  @db.Text
  documentName String? @db.VarChar(191)
  documentData String? @db.LongText
  sentToAccountant Boolean @default(false)
  date        DateTime @default(now()) @db.DateTime(3)
  referenceId Int?
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  @@index([type])
  @@index([category])
  @@index([date])
}
