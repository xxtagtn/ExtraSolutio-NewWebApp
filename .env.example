DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-before-production"
PORT=3001
VITE_API_URL="http://localhost:3001/api"

# Used by npm run user:admin
ADMIN_EMAIL="admin@extrasolutio.pt"
ADMIN_NAME="Administrador"
ADMIN_PASSWORD="change-this-password"

# WhatsApp Cloud API
# Generate these values in Meta Developers > Connect on WhatsApp > Basic setup.
# Never commit real tokens.
WHATSAPP_GRAPH_VERSION="v25.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_AUTO_REPLY_ENABLED="false"
WHATSAPP_AUTO_REPLY_COOLDOWN_MINUTES="1440"
WHATSAPP_AUTO_REPLY_MESSAGE="Olá. Este número é utilizado apenas para enviar notificações de serviço e não recebe respostas. Para esclarecer alguma questão, contacte a ExtraSolutio através dos canais habituais."
# Standby by default. Set to "true" only to activate automatic 24h reminders.
WHATSAPP_REMINDER_ENABLED="false"
WHATSAPP_REMINDER_INTERVAL_MINUTES="5"
WHATSAPP_REMINDER_STARTUP_DELAY_MS="15000"
WHATSAPP_REMINDER_TIMEZONE="Europe/Lisbon"
WHATSAPP_REMINDER_TEMPLATE_NAME="lembrete_servico_24h"
WHATSAPP_REMINDER_LANGUAGE_CODE="pt_PT"
# Variáveis do corpo do template, pela ordem aprovada na Meta.
WHATSAPP_REMINDER_TEMPLATE_FIELDS="collaborator,event,date,start,end,location,role"

# MySQL production example:
# DATABASE_URL="mysql://user:password@host:3306/extrasolutio"
