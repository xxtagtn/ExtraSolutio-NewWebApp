DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-before-production"
PORT=3001
VITE_API_URL="http://localhost:3001/api"

# Used by npm run user:admin
ADMIN_EMAIL="admin@extrasolutio.pt"
ADMIN_NAME="Administrador"
ADMIN_PASSWORD="change-this-password"

# WhatsApp Cloud API
# Generate these values in Meta Developers > Connect on WhatsApp > Basic setup.
# Never commit real tokens.
WHATSAPP_GRAPH_VERSION="v25.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# MySQL production example:
# DATABASE_URL="mysql://user:password@host:3306/extrasolutio"
